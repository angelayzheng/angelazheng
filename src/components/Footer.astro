---
import SocialLinks from "./SocialLinks.astro";
---

<footer
  class="from-aquamarine via-lilac to-salmon dark:from-teal dark:via-eggplant dark:to-rose bg-linear-90 pt-8 pb-6"
>
  <div class="flex flex-col items-center gap-2">
    <SocialLinks />
    <div class="mt-4">
      <img
        src="/images/signature-dark.png"
        alt="Handwritten text displaying 'Made with love by Angela Zheng'"
        width={200}
        loading="eager"
        class="block dark:hidden"
      />
      <img
        src="/images/signature-light.png"
        alt="Handwritten text displaying 'Made with love by Angela Zheng'"
        width={200}
        loading="eager"
        class="hidden dark:block"
      />
    </div>
    <div class="text-center text-sm italic">
      my website is <a
        href="https://github.com/angelayzheng/angelazheng"
        target="_blank"
        class="hover:text-teal dark:hover:text-aquamarine font-medium"
      >
        open source</a
      >!
    </div>
  </div>
</footer>
