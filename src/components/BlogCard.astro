---
import "../styles/global.css";

const { url, frontmatter } = Astro.props;
---

<article
  class="border-lilac/35 first:border-lilac/35 mx-auto w-full max-w-4xl border-b py-4 first:border-t md:py-5"
>
  <div
    class="grid grid-cols-1 items-start gap-2.5 md:grid-cols-[9rem,1fr] md:gap-5"
  >
    <div
      class="text-teal dark:text-aquamarine text-[0.7rem] tracking-[0.14em] uppercase md:pt-0.5 md:text-xs"
    >
      {
        new Date(frontmatter.date).toLocaleDateString("en-CA", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })
      }
    </div>

    <div class="flex flex-col gap-2 md:gap-2.5">
      <h2
        class="text-eggplant dark:text-lilac text-xl leading-tight font-semibold md:text-2xl"
      >
        <a href={url} class="decoration-2 underline-offset-4 hover:underline">
          {frontmatter.title}
        </a>
      </h2>

      <p
        class="text-dark/80 dark:text-light/80 text-sm leading-relaxed md:text-base"
      >
        {frontmatter.description}
      </p>

      {
        frontmatter.tags && frontmatter.tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5 pt-0.5">
            {frontmatter.tags.map((tag: string) => (
              <span class="border-rose/25 dark:border-salmon/35 text-rose dark:text-salmon rounded-full border px-2 py-0.5 text-[0.7rem]">
                {tag}
              </span>
            ))}
          </div>
        )
      }
    </div>
  </div>
</article>
