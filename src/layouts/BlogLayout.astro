---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Prose from "../components/Prose.astro";

const { frontmatter } = Astro.props;
---

<Layout title={frontmatter.title}>
  <article class="my-6 px-4 md:my-12">
    <div class="mx-auto w-full max-w-3xl">
      <a
        href="/blog"
        class="text-rose dark:text-salmon inline-flex items-center gap-1 text-sm md:text-base"
      >
        <span aria-hidden="true">&#8689;</span><span class="hover:underline">
          Back to Blog</span
        >
      </a>

      <header class="border-lilac/35 mt-5 border-b pb-6 md:mt-7 md:pb-8">
        <p
          class="text-teal dark:text-aquamarine text-xs tracking-[0.14em] uppercase md:text-sm"
        >
          {
            new Date(frontmatter.date).toLocaleDateString("en-CA", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })
          }
        </p>

        <h1
          class="text-eggplant dark:text-lilac mt-3 text-3xl leading-tight font-semibold md:text-5xl"
        >
          {frontmatter.title}
        </h1>

        <p
          class="text-dark/75 dark:text-light/80 mt-3 text-sm italic md:mt-4 md:text-base"
        >
          {frontmatter.description}
        </p>

        {
          frontmatter.tags && frontmatter.tags.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
              {frontmatter.tags.map((tag: string) => (
                <span class="border-rose/25 dark:border-salmon/35 text-rose dark:text-salmon rounded-full border px-2.5 py-0.5 text-xs">
                  {tag}
                </span>
              ))}
            </div>
          )
        }
      </header>

      <Prose class="prose-h1:text-left mt-8 max-w-none px-0 md:mt-10">
        <slot />
      </Prose>
    </div>
  </article>
</Layout>
