---
import "../styles/global.css";

import Layout from "../layouts/Layout.astro";
import Banner from "../components/Banner.astro";
import BlogCard from "../components//blog/BlogCard.astro";

const allPosts = Object.values(
  import.meta.glob("./blog/*.{md,mdx}", { eager: true }),
) as any[];

// sort by frontmatter.date (newest first). Handles missing/invalid dates.
const posts = allPosts.slice().sort((a, b) => {
  const da = new Date(a.frontmatter?.date || 0).getTime();
  const db = new Date(b.frontmatter?.date || 0).getTime();
  return db - da;
});
---

<Layout title="Blog">
  <Banner>
    <h1
      class="text-eggplant dark:text-lilac text-center text-4xl font-medium md:text-5xl"
    >
      Blog
    </h1>
    <div class="mt-6 text-center text-xl italic">
      thoughts of an overthinker <span class="not-italic">📚</span>
    </div>
  </Banner>

  <div class="mx-auto my-4 max-w-5xl px-4 py-4 md:px-6 lg:px-8">
    {
      posts.map((post: any) => (
        <BlogCard url={post.url} frontmatter={post.frontmatter} />
      ))
    }
  </div>
</Layout>
