---
import "../styles/global.css";
import { Image } from "astro:assets";

import Layout from "../layouts/Layout.astro";
import Banner from "../components/Banner.astro";
import Prose from "../components/Prose.astro";

import profilePic from "../images/profile-picture.jpg";
import profilePicDark from "../images/profile-picture-dark.jpg";

// Import the markdown content
const homeContent = await import("../pages/home.md");
---

<Layout title="Home">
  <Banner>
    <div
      class="flex flex-col items-center justify-center gap-8 md:flex-row md:gap-20"
    >
      <Image
        src={profilePic}
        alt="Angela in front of a pink and blue sunset"
        loading="eager"
        class="block size-40 rounded-full md:size-50 dark:hidden"
      />
      <Image
        src={profilePicDark}
        alt="Angela in front of a pink and blue sunset"
        loading="eager"
        class="hidden size-40 rounded-full md:size-50 dark:block"
      />
      <div class="flex flex-col gap-2 text-center md:text-left">
        <div class="text-xl md:text-2xl">Hi! I'm</div>
        <h1
          class="text-eggplant font-display dark:text-lilac mb-3 text-4xl font-medium md:text-6xl"
        >
          Angela Zheng
        </h1>
        <div class="text-lg md:text-xl">
          CS & Physics @ UofT | Toronto & Ottawa, Canada
        </div>
      </div>
    </div>
  </Banner>

  <Prose class="mx-auto my-10 max-w-4xl px-4 md:px-6 lg:px-8">
    <Fragment set:html={homeContent.compiledContent()} />
  </Prose>
</Layout>
